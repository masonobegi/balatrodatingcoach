# ─── Kinline environment ────────────────────────────────────────────────────
# Every one of these is OPTIONAL for local development. The store runs with an
# empty file: charts and orders live in memory, checkout is simulated, and email
# is written to the console. Each missing key disables exactly one thing, and
# the admin dashboard lists what is missing and what it costs you.
#
# See docs/14-deployment.md for where to get each value.

# ── Database ────────────────────────────────────────────────────────────────
# On Railway, reference the Postgres service instead of pasting a URL:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Neon also works — use its POOLED string and the driver switches automatically.
# Without it: everything is held in memory and lost on restart.
DATABASE_URL=

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY: checkout is simulated and refuses to run in prod.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in production.
# NEVER take real payments without this — an unverified webhook means orders
# are never recorded or fulfilled.
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without it: emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Kinline <orders@yourdomain.com>"
SUPPORT_EMAIL=hello@yourdomain.com

# ── Artwork storage (Cloudflare R2) ─────────────────────────────────────────
# Without it: artwork is rendered on demand rather than archived.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Fulfilment (Prodigi) ────────────────────────────────────────────────────
# Without it: paid orders queue as `awaiting_manual` in the dashboard, which is
# the right way to run the first dozen orders anyway.
PRODIGI_API_KEY=
PRODIGI_SANDBOX=true

# ── Admin ───────────────────────────────────────────────────────────────────
# Without ADMIN_PASSWORD you cannot see your own orders.
ADMIN_PASSWORD=
# Random 32+ chars. Signs the admin session cookie.
SESSION_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
